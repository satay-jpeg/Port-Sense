# ---------------------------------------------------------------------------
# Agent provider.
#
# RECOMMENDED SPLIT:
#   • Deployed (Render, public URL) -> Gemini free tier. No billing risk if a
#     stranger finds the URL; worst case is a rate limit.
#   • Local (this file)             -> Anthropic, for higher-quality answers
#     while you rehearse. Never expose a paid key on a public endpoint.
#
# ⚠️  Auto-detection prefers Gemini when several keys are present, so to use
#     Anthropic locally you MUST set AGENT_PROVIDER=claude explicitly below.
# ---------------------------------------------------------------------------

# --- Local development: Anthropic (paid — requires credits on the account) ---
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_PROVIDER=claude       # required, or the Gemini key below wins

# ---------------------------------------------------------------------------
# Everything below is what the DEPLOYED instance uses.
# ---------------------------------------------------------------------------

# Google Gemini — free tier, no credit card. Get a key at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=


# Model. Pick for FREE-TIER QUOTA, not raw capability — the limits differ a lot:
#   gemini-2.5-flash-lite  15 req/min, 1,000/day  <- best for demos
#   gemini-2.5-flash       10 req/min,   250/day
#   gemini-3.x (preview)   tighter still
# Run `npm run models` to see what your key can reach (★ = recommended).
# GEMINI_MODEL=gemini-2.5-flash-lite

# Self-throttle: max model requests per rolling minute before the agent steps
# aside to its rule-based router instead of getting 429'd. Set at or just below
# your model's RPM. One question costs 2-4 requests (each tool call is one).
# AGENT_RPM=10

# How often a machine stuck in alarm may re-trigger autonomous analysis (ms).
# AUTONOMOUS_COOLDOWN_MS=300000

# --- Alternative free providers (same adapter, just a different key) --------
# GROQ_API_KEY=          # https://console.groq.com/keys
# CEREBRAS_API_KEY=      # https://cloud.cerebras.ai
# OPENROUTER_API_KEY=    # https://openrouter.ai/keys
# ANTHROPIC_API_KEY=     # paid; https://console.anthropic.com

# Force a specific provider instead of auto-detecting:
#   gemini | groq | cerebras | openrouter | claude | rules
# AGENT_PROVIDER=gemini

# --- App settings ----------------------------------------------------------
# PORT=3000
# SENSOR_INTERVAL_MS=5000
